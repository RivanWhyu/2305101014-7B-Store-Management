<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_produk_item"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical">

    <!-- FOTO PRODUK -->
    <ImageView
        android:id="@+id/imgProduk"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_produk_image"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/outline_deployed_code_24"
        app:tint="@color/dashboard_blue"
        android:contentDescription="Foto produk"/>

    <!-- INFORMASI PRODUK -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNamaProduk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Produk"
            android:textColor="@color/dashboard_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/txtHargaProduk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rp 3.000"
            android:textColor="@color/dashboard_blue"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/outline_deployed_code_24"
                app:tint="#64748B"
                android:contentDescription="Stok"/>

            <TextView
                android:id="@+id/txtStokProduk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Stok: 120 pcs"
                android:textColor="@color/dashboard_gray"
                android:textSize="12sp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- TOMBOL EDIT DAN HAPUS -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- TOMBOL EDIT -->
        <TextView
            android:id="@+id/btnEditProduk"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_produk_edit"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✎"
            android:textColor="#1769E8"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- TOMBOL HAPUS -->
        <TextView
            android:id="@+id/btnHapusProduk"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_produk_hapus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🗑"
            android:textColor="#EF4444"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>