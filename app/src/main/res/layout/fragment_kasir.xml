<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7FF">

    <!-- HEADER BIRU -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="215dp"
        android:background="@drawable/bg_kasir_header"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- ICON KASIR -->
            <!-- Ganti emoji ini dengan drawable milikmu -->
            <TextView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:gravity="center"
                android:text="🛒"
                android:textSize="40sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kasir"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transaksi Penjualan"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- PANEL PUTIH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="180dp"
        android:background="@drawable/bg_profile_panel"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:clipToPadding="false">

        <!-- PENCARIAN -->
        <EditText
            android:id="@+id/edtCariProdukKasir"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_kasir_search"
            android:drawableStart="@drawable/outline_search_24"
            android:drawablePadding="12dp"
            android:hint="Cari produk..."
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="15sp"
            android:textColor="#102D5A"
            android:textColorHint="#8292B2"
            android:singleLine="true"
            android:inputType="text"
            android:elevation="1dp"/>

        <!-- KATEGORI -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnKategoriSemua"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_kasir_chip_active"
                    android:gravity="center"
                    android:paddingHorizontal="22dp"
                    android:text="Semua"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/btnKategoriElektronik"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_kasir_chip"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="Elektronik"
                    android:textColor="#344F80"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/btnKategoriMakanan"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_kasir_chip"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="Makanan"
                    android:textColor="#344F80"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/btnKategoriMinuman"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_kasir_chip"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="Minuman"
                    android:textColor="#344F80"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/btnKategoriLainnya"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_kasir_chip"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="Lainnya"
                    android:textColor="#344F80"
                    android:textSize="14sp"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- DAFTAR PRODUK -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProdukKasir"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingBottom="15dp"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"/>

    </LinearLayout>

</FrameLayout>
